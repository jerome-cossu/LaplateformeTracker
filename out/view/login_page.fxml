<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<GridPane fx:controller="src.controller.LoginController"
          xmlns:fx="http://javafx.com/fxml"
          alignment="center"
          hgap="15"
          vgap="15"
          style="-fx-background-color: #f0f4f8;">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Tittle -->
    <Label text="Connection"
           GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"
           />

    <!-- User Name -->
    <Label text="User Name :"
           GridPane.rowIndex="1" GridPane.columnIndex="0"
           style="-fx-text-fill: #1e3a8a;"/>
    <TextField fx:id="usernameField" promptText="Enter User Name"
               GridPane.rowIndex="1" GridPane.columnIndex="1"
               style="-fx-background-radius: 6; -fx-border-radius: 6;"/>

    <!-- Password -->
    <Label text="Password :"
           GridPane.rowIndex="2" GridPane.columnIndex="0"
           style="-fx-text-fill: #1e3a8a;"/>
    <PasswordField fx:id="passwordField" promptText="Enter Password"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                   style="-fx-background-radius: 6; -fx-border-radius: 6;"/>

    <!-- Buttuns -->
    <Button text="Connection" onAction="#handleLogin"
            GridPane.rowIndex="3" GridPane.columnIndex="0"
            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 6;"
            />
    <Button text="Create Account" onAction="#handleRegister"
            GridPane.rowIndex="3" GridPane.columnIndex="1"
            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6;"/>

    <!-- Error -->
    <Label fx:id="errorLabel"
           textFill="red"
           GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2"
           style="-fx-font-style: italic;"
           />
</GridPane>
