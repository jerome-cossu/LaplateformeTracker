<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="src.controller.StudentController">
    <Label text="First name" />
    <TextField fx:id="fnameField" />
    <Label text="Last name" />
    <TextField fx:id="lnameField" />
    <Label text="Age" />
    <TextField fx:id="ageField" />
    <Label text="Grade" />
    <TextField fx:id="gradeField" />
    <Button text="Add" onAction="#handleAddStudent" />
</VBox>
