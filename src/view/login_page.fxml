<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>

<GridPane fx:controller="src.controller.LoginController"
          xmlns:fx="http://javafx.com/fxml"
          alignment="center" hgap="10" vgap="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Nom d'utilisateur :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="usernameField" promptText="Nom d'utilisateur" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Mot de passe :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <PasswordField fx:id="passwordField" promptText="Mot de passe" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Button text="Connexion" onAction="#handleLogin" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <Button text="Créer un compte" onAction="#handleRegister" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label fx:id="errorLabel" textFill="red" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
</GridPane>
